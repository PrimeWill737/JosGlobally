  "private": true,
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx scripts/test-db.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify": "node scripts/verify-live.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "format": "prettier --write src tests scripts/*.ts next.config.ts",
    "test:adapter": "node --conditions=react-server --import tsx scripts/test-adapter.ts"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.9",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
